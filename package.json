{
  "name": "web-development-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Лабораторні з основ веб-розробки, варіант 3",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./lab2/styles.css --minify && node scripts/copy-css.cjs",
    "dev": "tailwindcss -i ./src/input.css -o ./lab2/styles.css --watch",
    "start": "node scripts/server.cjs",
    "test": "playwright test",
    "test:unit": "node --test tests/models.unit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "tailwindcss": "3.4.17"
  }
}
